"""
Zero-shot PIQA evaluation.

This script evaluates the TinyLLM on the PIQA task using answer-only log-likelihood scoring.

For each example:
- a practical goal is given
- two candidate solutions are provided
- the model scores both solutions
- the higher-scoring solution is selected

The script reports accuracy on the validation split and saves a CSV file
with predictions and scores for later analysis.

"""

import os
import argparse
import torch
import pandas as pd
from tqdm import tqdm
from datasets import load_dataset
from transformers import GPT2LMHeadModel, GPT2TokenizerFast, GPT2Config


# ---------------------------------------------------------------------
# Model loading
# ---------------------------------------------------------------------

def load_model(checkpoint_path: str, device: str):
    tokenizer = GPT2TokenizerFast.from_pretrained("gpt2")
    tokenizer.pad_token = tokenizer.eos_token

    config = GPT2Config.from_pretrained("gpt2")
    model = GPT2LMHeadModel(config)

    state_dict = torch.load(checkpoint_path, map_location=device)
    model.load_state_dict(state_dict)

    model.to(device)
    model.eval()

    return model, tokenizer


# ---------------------------------------------------------------------
# Scoring
# ---------------------------------------------------------------------

def score_completion(model, tokenizer, prompt: str, completion: str, device: str) -> float:
    """
    Compute answer-only log-likelihood for a candidate completion.
    Only completion tokens are scored; prompt tokens are masked out.
    Higher score is better.
    """
    full_text = prompt + completion

    prompt_ids = tokenizer(prompt, return_tensors="pt").input_ids.to(device)
    full_ids = tokenizer(full_text, return_tensors="pt").input_ids.to(device)

    labels = full_ids.clone()
    labels[:, :prompt_ids.shape[1]] = -100  # score only completion tokens

    with torch.no_grad():
        outputs = model(input_ids=full_ids, labels=labels)
        loss = outputs.loss.item()

    return -loss


# ---------------------------------------------------------------------
# Evaluation
# ---------------------------------------------------------------------

def evaluate_piqa(model, tokenizer, device: str, output_csv: str, limit=None):
    ds = load_dataset("piqa")
    split = ds["validation"]

    n = len(split) if limit is None else min(limit, len(split))

    correct = 0
    results = []

    for i in tqdm(range(n), desc="Evaluating PIQA"):
        ex = split[i]

        goal = ex["goal"].strip()
        sol1 = " " + ex["sol1"].strip()
        sol2 = " " + ex["sol2"].strip()
        gold = int(ex["label"])

        prompt = f"Question: {goal}\nAnswer:"

        score1 = score_completion(model, tokenizer, prompt, sol1, device)
        score2 = score_completion(model, tokenizer, prompt, sol2, device)

        pred = 0 if score1 > score2 else 1
        is_correct = int(pred == gold)

        correct += is_correct

        best_solution_model = ex["sol1"] if pred == 0 else ex["sol2"]

        results.append({
            "idx": i,
            "goal": goal,
            "sol1": ex["sol1"],
            "sol2": ex["sol2"],
            "gold": gold,
            "prediction": pred,
            "best_solution_model": best_solution_model,
            "score1": score1,
            "score2": score2,
            "correct": is_correct,
        })

    accuracy = correct / n

    results_df = pd.DataFrame(results)
    results_df.to_csv(output_csv, index=False)

    print(f"\nSaved predictions to: {output_csv}")
    print(f"PIQA accuracy: {accuracy:.4f}")


# ---------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(
        description="Zero-shot PIQA evaluation for GPT-style causal LMs"
    )
    parser.add_argument(
        "--checkpoint",
        type=str,
        required=True,
        help="Path to checkpoint .pth file"
    )
    parser.add_argument(
        "--output_csv",
        type=str,
        default="piqa_results.csv",
        help="Path to output CSV"
    )
    parser.add_argument(
        "--device",
        type=str,
        default="cuda" if torch.cuda.is_available() else "cpu",
        help="Device to run evaluation on (cuda or cpu)"
    )
    parser.add_argument(
        "--limit",
        type=int,
        default=None,
        help="Optional number of validation examples to evaluate"
    )

    args = parser.parse_args()

    print(f"Loading model from: {args.checkpoint}")
    print(f"Using device: {args.device}")

    model, tokenizer = load_model(args.checkpoint, args.device)

    evaluate_piqa(
        model=model,
        tokenizer=tokenizer,
        device=args.device,
        output_csv=args.output_csv,
        limit=args.limit
    )


if __name__ == "__main__":
    main()
